{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext (not "bundler"): the kernel ships as a real ESM package that Node
    // resolves at runtime, so the compiler must resolve imports the same way Node
    // will — explicit ".js" specifiers, package "exports" maps and all.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    // A library must ship its types: consumers get dist/index.d.ts, not source.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
